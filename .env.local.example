# AUGUST — environment
#
# EXACTLY the variables the code reads, grouped by what breaks without them.
# Nothing aspirational, nothing retired. Copy to .env.local and fill in.
#
# TWO KEYS COST REAL MONEY PER CALL and are marked $$ below: ANTHROPIC_API_KEY
# and TRANSCRIPT_PROVIDER_API_KEY. Everything else is free or free-tier.
#
# A NEW KEY GOES IN TWO PLACES: this file (for local dev) AND the Vercel
# project's environment variables (for deployed builds). Setting only one is
# the most common way a feature works locally and dies in production.


# ── NOTHING WORKS WITHOUT THESE ──────────────────────────────────────────────

# Upstash Redis (REST). This is the database. Without it there is no sign-in,
# no PIT, no THE CALL, no ideas book, no push, no /admin queue, no ask cache —
# and NO RATE LIMITING AT ALL, which means the global daily spend cap on the
# ask lane silently stops existing. Treat it as required.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# $$ Anthropic. PAID PER CALL. Powers the ask lane (the one model call the
# command bar makes), THE CALL's thesis line, and transcript extraction.
# Without it those three report "not configured" rather than failing oddly;
# commands, the book, and the desk keep working.
ANTHROPIC_API_KEY=


# ── SIGN-IN (email magic link via Resend — no passwords, no OAuth) ───────────

# Required in production. Signs the session JWT.
AUTH_SECRET=

# The Resend API key that actually sends the link. EITHER name works.
# Without it in development the magic link PRINTS TO THE SERVER CONSOLE, so
# the whole flow works locally with no key at all.
AUTH_RESEND_KEY=
RESEND_API_KEY=

# The From: address on the sign-in email. Must be a domain verified at Resend.
AUTH_EMAIL_FROM=

# Your email. Owner status is DERIVED from this at request time and never
# stored on the account, so changing it moves ownership immediately.
OWNER_EMAIL=


# ── THE OWNER DESK ───────────────────────────────────────────────────────────

# Bearer token for /admin and the admin APIs. Also the ONLY credential the
# transcript-fetch route accepts, in every environment including local dev —
# that route spends provider credits per call.
ADMIN_TOKEN=


# ── PUSH NOTIFICATIONS (THE CALL's one-per-trading-day notification) ─────────

# VAPID pair. Generate with: npx web-push generate-vapid-keys
# The public key must be set TWICE — the server signs with one, the browser
# subscribes with the NEXT_PUBLIC_ copy. They must match.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# mailto: address the push services contact about your sender
VAPID_SUBJECT=

# Shared secret for the manual send endpoint.
PUSH_SEND_SECRET=


# ── THE DAILY PASS ───────────────────────────────────────────────────────────

# Authenticates the one scheduled cron (/api/cron/intel-track, 22:10 UTC —
# post-close in both EST and EDT). It settles THE CALL, runs the idea tracker,
# backfills calendar actuals, and sends the day's push. Without it the route
# refuses to run.
CRON_SECRET=


# ── TRANSCRIPT INGEST ────────────────────────────────────────────────────────

# $$ Supadata. PAID IN CREDITS PER CALL. The link→transcript intake in /admin.
# Cost discipline is built in: native transcripts only (a flat 1 credit rather
# than the provider's 2-credits-per-MINUTE AI fallback), and metadata is only
# bought after the transcript succeeds. Unset, the owner pastes by hand.
TRANSCRIPT_PROVIDER_API_KEY=
# adapter selector; "supadata" is the only implemented value and the default
TRANSCRIPT_PROVIDER=


# ── FREE DATA KEYS (each degrades honestly when unset) ───────────────────────

# FRED (free, fredaccount.stlouisfed.org). Unset: the 10Y-2Y spread and the
# financial-stress gauge report unavailable, and economic-calendar cards lose
# their printed actuals rather than inventing one.
FRED_API_KEY=

# Finnhub (free tier). Unset: the /intel CATALYSTS earnings line is HIDDEN
# rather than rendering placeholder rows. Nothing else uses it.
FINNHUB_API_KEY=

# YouTube Data API (free, quota-limited). Unset: videos are added by URL using
# keyless metadata; only channel auto-discovery is lost.
YOUTUBE_API_KEY=

# OpenSky (free OAuth2 client credentials). Unset: the flights lookup goes out
# anonymously — sparser and rate-limited, never an error. Only affects how much
# context an ask gets.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=


# ── SPEND AND RATE DIALS (all optional; all tunable without a deploy) ────────

# Per-identity ask cap per UTC day. Defaults: 20 anonymous, 100 signed-in.
# Cache hits deliberately do NOT count against these.
ASK_CAP_ANON=
ASK_CAP_USER=

# Per-IP sliding window for the ask lane, per minute. Default 10 — the
# tightest limit in the table, because it is real spend on anonymous traffic.
CHAT_RATE_PER_MIN=

# Per-IP window for the admin APIs, per minute. Default 240. Deliberately high:
# one APPROVE tap costs 2-3 requests and 30/min ran out ten taps into triaging
# a single video. This is a runaway backstop for one authenticated human, not
# an abuse control — the admin gate is the abuse control.
ADMIN_RATE_PER_MIN=

# GLOBAL daily ask budget across ALL visitors. Default 400. There is no "off"
# value by design: 0 or unset gives the default. Requires Upstash to work.
CHAT_DAILY_CAP=


# ── BEHAVIOUR ────────────────────────────────────────────────────────────────

# How many days an untouched idea waits before it is visibly marked STALE.
# Default 3 (both the tracker and the published book).
TRACKER_STALE_DAYS=

# Set to exactly "desk" to drop third-party RSS from the front page and fall
# back to the desk's own tape. Any other value behaves as unset.
PUBLIC_FEED_MODE=

# Absolute origin used for canonical and OG URLs. Deliberately has no default:
# a hardcoded localhost fallback would ship localhost image URLs to production.
# Unset, Next falls back to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=


# ── SET BY THE PLATFORM — DO NOT PUT THESE HERE ──────────────────────────────
# NODE_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL are injected by Next.js
# and Vercel. The code reads them; you never set them. NODE_ENV in particular
# drives every fail-closed decision (the dev console magic link, the refusal of
# forgeable dev identities in production, the cron guards).
